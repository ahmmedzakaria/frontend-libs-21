      "path": "./projects/api-common/tsconfig.lib.json"
    },
    {
      "path": "./projects/api-common/tsconfig.spec.json"
    },
    {
      "path": "./projects/shared/tsconfig.lib.json"
    },
    {
      "path": "./projects/shared/tsconfig.spec.json"
    },
    {
      "path": "./projects/layout/tsconfig.lib.json"
    },
    {
      "path": "./projects/layout/tsconfig.spec.json"
    },
    {
      "path": "./projects/auth/tsconfig.lib.json"
    },
    {
      "path": "./projects/auth/tsconfig.spec.json"
    }
  ]
}
